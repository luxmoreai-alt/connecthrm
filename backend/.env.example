# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
NODE_ENV=production

# Frontend URLs. Use exact comma-separated URLs for production and previews.
CORS_ORIGIN=https://hrm-5byz.vercel.app
APP_URL=https://hrm-5byz.vercel.app
COOKIE_SAME_SITE=none

# Authentication
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# Connect HR email (ZeptoMail SMTP)
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=your-zeptomail-smtp-token
SMTP_FROM=connecthr@luxmorai.com
SMTP_FROM_NAME=Connect HR

# Create a public Vercel Blob store and connect it to the backend project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Web Push notifications. Generate once with: npm run push:generate-keys
# Keep the private key secret and use the same pair for every deployment.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:connecthr@luxmorai.com

# Offer Studio integration. This must be the Offer Studio backend URL.
OFFER_APP_URL=https://offer-backend-seven.vercel.app
# Use the same secret as HRMS_SYNC_TOKEN in Offer Studio.
OFFER_SYNC_TOKEN=replace-with-a-long-random-shared-token

# Optional for non-Vercel PDF generation hosts
CHROME_PATH=
